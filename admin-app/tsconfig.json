{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "integration/**/*.tsx",
    "integration/**/*.ts",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "dist-native",
    "tests"
  ]
}
