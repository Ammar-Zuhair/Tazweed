# Phase06 server configuration. Runtime and migration credentials must be separate.
# Server only. Values are placeholders. Never copy this file into a mobile bundle.
NODE_ENV=development
APP_ENV=staging
PORT=8084
HOST=127.0.0.1
DATABASE_URL=postgresql://LIMITED_APP_USER:PASSWORD@HOST:5432/tazweed_staging
# Operator commands only; omit this from the HTTP process environment.
MIGRATION_DATABASE_URL=postgresql://MIGRATION_OWNER:PASSWORD@HOST:5432/tazweed_staging
PUBLIC_BASE_URL=https://YOUR-STAGING-DOMAIN
CORS_ALLOWED_ORIGINS=https://YOUR-STAGING-DOMAIN
# Ed25519 PKCS8 private / SPKI public PEM; literal \n is decoded.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# At least32 cryptographically random bytes, hex encoded (64 hex characters).
OTP_HMAC_SECRET=
OTP_PROVIDER=UNCONFIGURED
OTP_PROVIDER_URL=
OTP_PROVIDER_TOKEN=
# Deferred: optional vendor-specific adapter metadata, not consumed by the generic gateway.
OTP_SENDER_ID=
WHATSAPP_AUTH_TEMPLATE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BASE_URL=
ROUTING_BASE_URL=
EXPO_ACCESS_TOKEN=
STORE_SUPPORT_PHONE=
PRIVACY_CONTACT_EMAIL=
# Deferred11: configure retention only after owner approval;06 only prunes abandoned pending uploads.
TRANSACTION_RETENTION_DAYS=

# Phase07 routing: fill owned OSRM endpoint later; optional server-only Bearer key.
ROUTING_PROVIDER=UNCONFIGURED
ROUTING_API_KEY=
ROUTING_PROFILE=driving
ROUTING_TIMEOUT_MS=5000
ROUTING_MAX_SNAP_M=200

# Phase08: limits/monitoring only, no payment-gateway secret needed.
RECEIPT_ATTEMPT_LIMIT_PER_HOUR=6
RECEIPT_REVIEW_ALERT_MINUTES=60

# Phase09 adds no external service keys. Commission rates and courier branches are stored in PostgreSQL; existing OTP/R2/Routing tests await owner request.
