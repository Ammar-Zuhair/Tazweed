  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "tsx": "4.23.15",
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
