# Phase 01: only APP_ENV is consumed; the remaining service placeholders belong to later phases.
# Public values only. Never add service secrets here.
EXPO_PUBLIC_API_BASE_URL=https://YOUR-STAGING-DOMAIN/api/v1
EXPO_PUBLIC_APP_ENV=preview
EXPO_PUBLIC_APP_KIND=courier
EXPO_PUBLIC_EAS_PROJECT_ID=
# Map display configuration comes from the backend public endpoint.
