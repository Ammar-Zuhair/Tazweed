{
  "name": "tazweed-customer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --max-workers 2",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native --max-workers 2",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "58.0.21",
    "expo-constants": "58.0.14",
    "expo-dev-client": "58.0.17",
    "expo-font": "58.0.11",
    "expo-linking": "58.0.15",
    "expo-localization": "58.0.5",
    "expo-router": "58.0.28",
    "expo-splash-screen": "58.0.12",
    "expo-status-bar": "58.0.4",
    "expo-system-ui": "58.0.7",
    "expo-updates": "58.0.19",
    "expo-video": "58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-web": "0.21.4"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
