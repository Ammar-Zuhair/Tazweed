{
  "name": "tazweed-customer",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --tunnel --go --port 8091",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "export:web": "expo export --platform web --max-workers 2",
    "export:native": "expo export --platform android --platform ios --output-dir dist-native --max-workers 2",
    "test": "node --import tsx --test tests/*.test.ts",
    "start:local": "expo start --lan --go --port 8091"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "57.0.32",
    "expo-application": "57.0.3",
    "expo-clipboard": "57.0.2",
    "expo-constants": "57.0.23",
    "expo-crypto": "57.0.4",
    "expo-device": "57.0.2",
    "expo-font": "57.0.4",
    "expo-image-picker": "57.0.21",
    "expo-linking": "57.0.13",
    "expo-localization": "57.0.2",
    "expo-location": "57.0.23",
    "expo-notifications": "57.0.25",
    "expo-router": "57.0.30",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.11",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "expo-updates": "57.0.27",
    "expo-video": "57.0.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "0.21.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@expo/ngrok": "4.1.3",
    "@types/react": "19.2.4",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  }
}
